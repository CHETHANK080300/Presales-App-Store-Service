{
  "apiURL": "https://f1e02a7b-ebc2-4fa9-9aa8-ca5fc12935dc.mock.pstmn.io/corporate-details",
  "servicetype": "HTTP",
  "methodType": "GET",
  "contentType": "application/json",
  "headers": {
    "Accept": "application/json"
  },
  "requestDef": {
    "customerId": "${REQUEST~requestBody.corporateID}"
  },
  "responseDef": {
    "serviceStatusCode": "${RESPONSE~serviceStatusCode}",
    "corporateDetails": {
      "CUSTOMER_ID": "${RESPONSE~corporateDetails.CUSTOMER_ID}",
      "CLIENT_NAME": "${RESPONSE~corporateDetails.CLIENT_NAME}",
      "EMAIL": "${RESPONSE~corporateDetails.EMAIL}",
      "PHONE_NO": "${RESPONSE~corporateDetails.PHONE_NO}"
    },
    "accounts": {
      "ACCOUNT_NO": "${RESPONSE~accounts.0.ACCOUNT_NO}",
      "ACC_HOLDER_NAME": "${RESPONSE~accounts.0.ACC_HOLDER_NAME}",
      "CURRENT_BALANCE": "${RESPONSE~accounts.0.CURRENT_BALANCE}"
    }
  },
  "logging": {
    "logRequired": "Y",
    "logType": "BOTH"
  },
  "timeout": "30"
}
